# Copy to .env. All keys remain on your local server, never in the browser.
PORT=4174
# TAO_LAB_HOME=/absolute/path/to/your/existing/.tao-lab
TAO_LLM_ENABLED=0
# Full chat-completions endpoint. No URL fetching of imported source links.
TAO_LLM_URL=https://your-provider.example/v1/chat/completions
TAO_LLM_MODEL=your-model
TAO_LLM_KEY=
TAO_LLM_TIMEOUT_MS=45000
# Optional; omit for providers/models that do not accept temperature.
# TAO_LLM_TEMPERATURE=0.2
