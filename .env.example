# v0.4: External Agent mode needs NONE of the TAO_LLM_* fields.
# Pair in the Web UI; model authorization stays in your own Agent host.
# Copy to .env. Keys stay on the local server, never sent to the browser.
PORT=4174
# TAO_LAB_HOME=/absolute/path/to/your/existing/.tao-lab
TAO_LLM_ENABLED=0
# Complete Chat Completions endpoint; no automatic URL suffix is added.
TAO_LLM_URL=https://your-provider.example/v1/chat/completions
TAO_LLM_MODEL=your-model
TAO_LLM_KEY=
# Per-call limit: 1000–600000ms. No more silent 120s clamp. No auto retry.
TAO_LLM_TIMEOUT_MS=180000
# Optional parameters: omitted unless explicitly set; provider must support them.
# TAO_LLM_TEMPERATURE=0.2
# TAO_LLM_THINKING=enabled
# TAO_LLM_REASONING_EFFORT=low
# Choose ONE supported token field; do not set both.
# TAO_LLM_MAX_TOKENS=8192
# TAO_LLM_MAX_COMPLETION_TOKENS=8192
# Optional overrides for the short mapping task vs. insight exploration.
# DeepSeek-compatible examples; do not enable these for incompatible providers.
# TAO_LLM_MAPPING_THINKING=disabled
# TAO_LLM_MAPPING_REASONING_EFFORT=default
# TAO_LLM_MAPPING_MAX_TOKENS=4096
# TAO_LLM_MAPPING_TIMEOUT_MS=180000
# TAO_LLM_INSIGHT_THINKING=enabled
# TAO_LLM_INSIGHT_REASONING_EFFORT=low
# TAO_LLM_INSIGHT_MAX_TOKENS=8192
# TAO_LLM_INSIGHT_TIMEOUT_MS=240000
# THINKING / REASONING_EFFORT = default omits that parameter at this stage.
# Updating .env requires restarting the local server.
